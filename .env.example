# Get a Gemini API key at https://aistudio.google.com/apikey
# Set it here to enable chat for everyone using your deployment.
# Alternatively, enter a key in the app's settings (kept in that browser tab only).
GEMINI_API_KEY=

# Optional: change the port or model ID if your provider uses a different alias.
PORT=5173
GEMINI_MODEL=gemini-4-hydrogen
